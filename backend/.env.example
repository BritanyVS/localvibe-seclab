PORT=4000
ADMIN_PASSWORD=localvibe-demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# [SEGURIDAD] Escenario intencional del laboratorio: con "true", Vibe incorpora
# los comentarios de las reseñas al prompt como si fueran instrucciones, de modo
# que un comentario malicioso puede manipular al asistente (prompt injection).
# Déjalo en "false" para el comportamiento normal.
VIBE_TRUST_REVIEWS=true
PLACES_FILE=
# PostgreSQL (activa el modo base de datos; sin ella se usa data/places.json)
# Local (docker compose up -d):
DATABASE_URL=postgres://localvibe:localvibe@localhost:5432/localvibe?sslmode=disable
# Gratis: Neon o Supabase (deja el valor SIN el signo # delante y quita la línea local):
# DATABASE_URL=postgres://user:pass@ep-xxxx.neon.tech/localvibe?sslmode=require